# Set default behavior to automatically normalize line endings
* text=auto

# Explicitly declare text files you want to always have LF line endings on checkout
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.html text eol=lf
*.css text eol=lf

# Windows Batch scripts always use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.pt binary
*.bin binary
*.mp4 binary
*.wav binary
*.mp3 binary
