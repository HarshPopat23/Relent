# ==============================================================================
# Relent AI Configuration Template
# Copy this file to .env and configure for your local environment:
# cp .env.example .env
# ==============================================================================

# -- Ollama LLM Configuration --
OLLAMA_HOST=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
# Primary Reasoning & Tone-Matching LLM: Qwen2.5-72B (4-bit quantized)
OLLAMA_MODEL=qwen2.5:72b-instruct-q4_K_M
# Hindi-Specialized & Failover Fallback LLM: Sarvam-M
OLLAMA_FALLBACK_MODEL=sarvam-m
# Optional: Set OLLAMA_NUM_GPU=0 to force CPU mode, or leave empty for auto GPU offloading
OLLAMA_NUM_GPU=

# -- Whisper Speech-to-Text Configuration --
# Options: tiny, base, small, medium, large-v3, turbo
WHISPER_MODEL=large-v3
# Options: auto (default), faster-whisper, whisper
WHISPER_BACKEND=auto
# Options: int8 (default for CPU), float16 (default for CUDA), int8_float16
WHISPER_COMPUTE_TYPE=
WHISPER_MODEL_DIR=whisper_models

# -- IndicWhisper (Hinglish Transcription) --
INDICWHISPER_MODEL=ai4bharat/indicwhisper
# Leave empty for dynamic auto-detection ('cuda:0' if GPU available, else 'cpu')
INDICWHISPER_DEVICE=

# -- Audio Ingestion & Chunking --
# Duration in minutes per processing chunk for long video files
MAX_CHUNK_DURATION_MINUTES=10

# -- Video Clipper & Highlight Reels --
# Options: copy (instant stream-copy with ultrafast fallback), ultrafast (force libx264 ultrafast re-encode)
REEL_CLIP_MODE=copy

# -- Vector Database --
CHROMA_PERSIST_DIR=vector_db
COLLECTION_NAME=meeting_transcript
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# -- Backend Server Settings --
HOST=127.0.0.1
PORT=8000
RELOAD=false
CORS_ORIGINS=*
LOG_LEVEL=info
