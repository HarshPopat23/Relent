# ==============================================================================
# Relent AI Configuration Template
# Copy this file to .env and configure for your local environment:
# cp .env.example .env
# ==============================================================================

# -- Ollama LLM Configuration --
OLLAMA_HOST=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# -- Whisper Speech-to-Text Configuration --
# Options: tiny, base, small, medium, large-v3, turbo
WHISPER_MODEL=small
WHISPER_MODEL_DIR=whisper_models

# -- IndicWhisper (Hinglish Transcription) --
INDICWHISPER_MODEL=ai4bharat/indicwhisper
INDICWHISPER_DEVICE=cpu
# Set to 'cuda' if NVIDIA GPU is available

# -- Audio Ingestion & Chunking --
# Duration in minutes per processing chunk for long video files
MAX_CHUNK_DURATION_MINUTES=10

# -- Vector Database --
CHROMA_PERSIST_DIR=vector_db
COLLECTION_NAME=meeting_transcript
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# -- Backend Server Settings --
HOST=127.0.0.1
PORT=8000
RELOAD=false
CORS_ORIGINS=*
LOG_LEVEL=info
